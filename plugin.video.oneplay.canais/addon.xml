<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<addon id="plugin.video.oneplay.canais" name="OnePlay Canais" version="0.0.15" provider-name="ONEPLAY">
  <requires>
    <import addon="xbmc.python" version="3.0.0" />
  </requires>
  <extension point="xbmc.python.pluginsource" library="addon.py">
    <provides>video</provides>
  </extension>
  <extension point="xbmc.addon.metadata">
    <summary lang="pt_BR">Catálogo OnePlay organizado por conteúdo, com reprodução HLS e proxy local.</summary>
